(function(){

	var oContentMgr = App.getContentMgr();

		// Remove makeup layers
		var sScript = oContentMgr.getAbsolutePath( String( "/data/Daz 3D/Genesis 9/Base/Tools/Utilities/Toon Layers Remove - Makeup.dse" ), false, "" );
		if( sScript ){
			oContentMgr.openFile( sScript, true );
		}
		// Apply makeup L.I.E. preset
		var sFile = oContentMgr.getAbsolutePath( String( "/data/Daz 3D/Genesis 9/Base/Tools/Script Loads/Daz Anime/G9AnimeAllFace01.duf" ), false, "" );
		if( sFile ){
			oContentMgr.openFile( sFile, true );
		}

})();